# ─── Required ─────────────────────────────────────────────
# Your Algorand TestNet address that receives payments (58 characters)
AVM_ADDRESS=your_algorand_address_here

# Mnemonic for the x402 client (hot wallet that PAYS for API calls in the preview)
# Must have TestNet USDC (ASA 10458941) opted in and funded
# This is the BUYER wallet — not the same as AVM_ADDRESS (which is the SELLER)
X402_MNEMONIC=word1 word2 word3 ... word25

# ─── Optional ─────────────────────────────────────────────
# Facilitator URL (default: goplausible public facilitator for Algorand)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Server port (default: 4021)
PORT=4021

# To run with your own local facilitator, uncomment below
# FACILITATOR_URL=http://localhost:4022
